{
  "name": "agent-os",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "ask": "node scripts/ask.mjs",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev:gateway": "npm run dev -w @aios/gateway",
    "dev:orchestrator": "npm run dev -w @aios/orchestrator",
    "dev:research": "AGENT_NAME=research npm run dev -w @aios/agents",
    "dev:retrieval": "AGENT_NAME=retrieval npm run dev -w @aios/agents"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
